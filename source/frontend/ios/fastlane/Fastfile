# frozen_string_literal: true

default_platform :ios

BUNDLE_ID    = "com.icimden.app"
PROJECT_ROOT = File.expand_path("../../", __dir__)
FLUTTER_BIN  = "flutter"

def dart_defines_for(env)
  base = {
    "SUPABASE_URL"               => ENV["DART_DEFINE_SUPABASE_URL"],
    "SUPABASE_ANON_KEY"          => ENV["DART_DEFINE_SUPABASE_ANON_KEY"],
    "ANDROID_INTERSTITIAL_AD_ID" => ENV["DART_DEFINE_ANDROID_INTERSTITIAL_AD_ID"],
    "ANDROID_BANNER_AD_ID"       => ENV["DART_DEFINE_ANDROID_BANNER_AD_ID"],
    "IOS_INTERSTITIAL_AD_ID"     => ENV["DART_DEFINE_IOS_INTERSTITIAL_AD_ID"],
    "IOS_BANNER_AD_ID"           => ENV["DART_DEFINE_IOS_BANNER_AD_ID"],
  }
  case env
  when :staging
    base.merge("APP_ENV" => "staging")
  when :prod
    base.merge("APP_ENV" => "prod")
  end.map { |k, v| "--dart-define=#{k}=#{v}" }.join(" ")
end

def build_flutter_ios(env:)
  version   = ENV["APP_VERSION"]
  build_num = ENV["BUILD_NUMBER"]
  defines   = dart_defines_for(env)

  Dir.chdir(PROJECT_ROOT) do
    sh "#{FLUTTER_BIN} pub get"
    cmd = "#{FLUTTER_BIN} build ipa --release --no-codesign #{defines}"
    cmd += " --build-name=#{version} --build-number=#{build_num}" if version && build_num
    sh cmd
  end
end

platform :ios do
  desc "Run Flutter tests"
  lane :test do
    Dir.chdir(PROJECT_ROOT) { sh "flutter test --coverage" }
  end

  desc "Build staging IPA and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_filepath: "fastlane/keys/asc_api_key.json",
      duration:     1200,
      in_house:     false,
    )

    match(type: "appstore", readonly: true, api_key: api_key, app_identifier: BUNDLE_ID)

    build_flutter_ios(env: :staging)

    gym(
      workspace:        "Runner.xcworkspace",
      scheme:           "Runner",
      export_method:    "app-store",
      output_directory: "build/ios/ipa",
      output_name:      "Icimden-staging.ipa",
      xcargs:           "CODE_SIGN_STYLE=Manual",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => "match AppStore #{BUNDLE_ID}" },
      },
    )

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               "build/ios/ipa/Icimden-staging.ipa",
      skip_waiting_for_build_processing: true,
      changelog:                         "Staging – #{ENV['GITHUB_SHA']&.slice(0, 7)}",
    )
  end

  desc "Build production IPA and submit to App Store"
  lane :release do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_filepath: "fastlane/keys/asc_api_key.json",
      duration:     1200,
      in_house:     false,
    )

    match(type: "appstore", readonly: true, api_key: api_key, app_identifier: BUNDLE_ID)

    build_flutter_ios(env: :prod)

    gym(
      workspace:        "Runner.xcworkspace",
      scheme:           "Runner",
      export_method:    "app-store",
      output_directory: "build/ios/ipa",
      output_name:      "Icimden-release.ipa",
      xcargs:           "CODE_SIGN_STYLE=Manual",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => "match AppStore #{BUNDLE_ID}" },
      },
    )

    upload_to_app_store(
      api_key:                           api_key,
      ipa:                               "build/ios/ipa/Icimden-release.ipa",
      submit_for_review:                 false,
      automatic_release:                 false,
      force:                             true,
      skip_metadata:                     true,
      skip_screenshots:                  true,
      precheck_include_in_app_purchases: false,
    )
  end
end
